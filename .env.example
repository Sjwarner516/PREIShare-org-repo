# .env.example — SAFE TO COMMIT
# Copy this file to .env (or .env.local) and replace placeholders with values
# from your Supabase project settings. NEVER commit the real .env file.
#
# This app is Vite + TanStack Start. Names that start with VITE_ can be
# read in browser code via import.meta.env and may ship in the client bundle.
# Only public values get that prefix. Never name the service-role key
# VITE_SUPABASE_SERVICE_ROLE_KEY.
#
# Source of truth: docs/sponsor-auth-requirements.md

# ---- Client-safe (may be used in browser code under RLS) ----
# Public Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe in the browser ONLY because RLS policies protect data)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Server-only (MUST NOT be imported into client/browser bundles) ----
# Service role key bypasses RLS. Use only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: same URL without a VITE_ prefix for server-side reads
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only embedding provider (generate.ts). Never prefix with VITE_.
# Must produce vectors of length 1536 (docs/embedding-data-model.md).
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
# Optional OpenAI-compatible embeddings URL
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# Offline practice only (returns a 1536-length dummy vector; not for seed ranking)
# EMBEDDING_MOCK=1

# Local seed script only (scripts/seed-property-embeddings.ts). UUID of an
# existing auth.users row — properties.owner_id is NOT NULL.
SEED_OWNER_ID=00000000-0000-0000-0000-000000000000
