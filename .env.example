# .env.example — commit this file. Never put real keys here.
# Copy to .env.local (or .env) for local development and fill in values
# from Supabase → Project Settings → API.
#
# This TanStack Start app uses Vite. Only names that start with VITE_ are
# exposed to browser code via import.meta.env. Do not put the service-role
# key behind VITE_ (never VITE_SUPABASE_SERVICE_ROLE_KEY).
#
# PUBLIC / BROWSER-SAFE (may be exposed to the client bundle)
# These values are NOT secret when Row Level Security is enabled.
# Match docs/requirements/sponsor-auth-and-listings-brief.md (client-safe).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY SECRETS (never prefix for client exposure; never import in browser code)
# Service role bypasses Row Level Security — TanStack Start server routes/loaders only.
# Must never ship in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: same URL without a public prefix for server code that reads non-VITE_ vars
SUPABASE_URL=https://your-project-ref.supabase.co
